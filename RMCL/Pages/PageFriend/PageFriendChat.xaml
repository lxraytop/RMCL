<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:RMCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageFriendChat" PanScroll="PanMsgScroll">
    <Grid Margin="18,10,18,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColConv" Width="208" />
            <ColumnDefinition x:Name="ColConvGap" Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 会话列表（可折叠） -->
        <local:MyCard x:Name="CardConv" Grid.Column="0" Title="会话">
            <Grid Margin="12,38,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LabConvHint" VerticalAlignment="Center" FontSize="12" Opacity="0.6" Text="加载中……" />
                    <local:MyButton Grid.Column="1" x:Name="BtnAddFriend" Text="加好友" MinWidth="62" Height="26" Padding="8,0" Margin="0,0,6,0" />
                    <local:MyButton Grid.Column="2" x:Name="BtnNewGroup" Text="建群" MinWidth="54" Height="26" Padding="8,0" />
                </Grid>
                <local:MyScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PanConv" />
                </local:MyScrollViewer>
            </Grid>
        </local:MyCard>

        <!-- 聊天区 -->
        <local:MyCard Grid.Column="2" Title="聊天">
            <Grid Margin="14,38,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="LabConvTitle" FontSize="15" FontWeight="SemiBold" Text="选择一个会话" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="LabConvSub" FontSize="11.5" Opacity="0.6" Margin="0,2,0,0" Text="也可以从通讯录或群聊里打开" />
                    </StackPanel>
                    <local:MyButton Grid.Column="1" x:Name="BtnToggleConv" Text="收起会话" MinWidth="82" Height="26" Padding="8,0" Margin="0,0,6,0"
                                    ToolTip="收起左侧会话列表，让聊天区更宽" />
                    <local:MyButton Grid.Column="2" x:Name="BtnRefresh" Text="刷新" MinWidth="58" Height="26" Padding="8,0" />
                </Grid>

                <local:MyScrollViewer Grid.Row="1" x:Name="PanMsgScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PanMsg" Margin="2,0,2,4">
                        <local:MyButton x:Name="BtnLoadMore" Text="查看更早的消息" MinWidth="130" Height="26" Padding="10,0"
                                        HorizontalAlignment="Center" Margin="0,4,0,12" Visibility="Collapsed" />
                        <TextBlock x:Name="LabEmpty" Margin="6,30,0,0" TextWrapping="Wrap" LineHeight="20" Opacity="0.6"
                                   Text="还没有打开任何会话。&#xa;从左侧选择一个会话，或者到「通讯录」里找好友开始聊天。" />
                    </StackPanel>
                </local:MyScrollViewer>

                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <local:MyTextBox x:Name="TextMessage" Height="66" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" Padding="9,7" VerticalScrollBarVisibility="Auto"
                                     HintText="输入消息，Enter 发送，Shift+Enter 换行" />
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LabSendHint" VerticalAlignment="Center" FontSize="11.5" Opacity="0.55"
                                   TextWrapping="Wrap" Text="消息中的邀请码、tcp:// 节点和 HTTP(S) 服务器地址都可以一键导入。" />
                        <local:MyButton Grid.Column="1" x:Name="BtnSend" Text="发送" MinWidth="88" Height="32" Padding="13,0" ColorType="Highlight" />
                    </Grid>
                </Grid>
            </Grid>
        </local:MyCard>
    </Grid>
</local:MyPageRight>
