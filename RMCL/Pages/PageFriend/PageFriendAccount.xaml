<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:RMCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageFriendAccount"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">

            <!-- ===== 未登录：注册 / 登录 ===== -->
            <StackPanel x:Name="PanAuth">
                <local:MyCard Margin="0,15" Title="好友账号">
                    <StackPanel Margin="25,40,25,18">
                        <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,14"
                                   Text="好友功能使用独立的 RMCL 账号。注册需要邀请码与邮箱验证；已经登录过 RaySkin 的话，可以直接用 RaySkin 一键登录。" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <local:MyButton x:Name="BtnTabLogin" Text="登录" MinWidth="96" Height="32" Padding="13,0" ColorType="Highlight" Margin="0,0,10,0" />
                            <local:MyButton x:Name="BtnTabRegister" Text="注册" MinWidth="96" Height="32" Padding="13,0" Margin="0,0,10,0" />
                            <local:MyButton x:Name="BtnTabRayskin" Text="RaySkin 一键登录" MinWidth="150" Height="32" Padding="13,0" />
                        </StackPanel>

                        <!-- 登录 -->
                        <StackPanel x:Name="PanLogin">
                            <Grid Height="28" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="邮箱" VerticalAlignment="Center" Margin="1,0,16,0" />
                                <local:MyTextBox Grid.Column="1" x:Name="TextLoginEmail" Width="300" Height="28"
                                                 HorizontalAlignment="Left" HintText="name@example.com" />
                            </Grid>
                            <Grid Height="28" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="密码" VerticalAlignment="Center" Margin="1,0,16,0" />
                                <PasswordBox Grid.Column="1" x:Name="TextLoginPass" Width="300" Height="28" HorizontalAlignment="Left" />
                            </Grid>
                            <Grid Height="35">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <local:MyButton x:Name="BtnLogin" Text="登录" MinWidth="110" Height="35" Padding="13,0" ColorType="Highlight" Margin="0,0,12,0" />
                                <local:MyButton Grid.Column="1" x:Name="BtnOpenRegister" Text="还没有账号？注册" MinWidth="150" Height="35" Padding="13,0" />
                            </Grid>
                        </StackPanel>

                        <!-- 注册 -->
                        <StackPanel x:Name="PanRegister" Visibility="Collapsed">
                            <Grid Height="28" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="邮箱" VerticalAlignment="Center" Margin="1,0,16,0" />
                                <local:MyTextBox Grid.Column="1" x:Name="TextRegEmail" Width="300" Height="28"
                                                 HorizontalAlignment="Left" HintText="用于接收验证码，也是登录账号" />
                            </Grid>
                            <Grid Height="28" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="验证码" VerticalAlignment="Center" Margin="1,0,16,0" />
                                <local:MyTextBox Grid.Column="1" x:Name="TextRegCode" Width="150" Height="28" HorizontalAlignment="Left" HintText="6 位数字" />
                                <local:MyButton Grid.Column="2" x:Name="BtnSendCode" Text="发送验证码" MinWidth="110" Height="28" Padding="13,0" Margin="12,0,0,0" />
                            </Grid>
                            <Grid Height="28" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="昵称" VerticalAlignment="Center" Margin="1,0,16,0" />
                                <local:MyTextBox Grid.Column="1" x:Name="TextRegName" Width="300" Height="28"
                                                 HorizontalAlignment="Left" HintText="2-16 个字符，可重复" />
                            </Grid>
                            <Grid Height="28" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="密码" VerticalAlignment="Center" Margin="1,0,16,0" />
                                <PasswordBox Grid.Column="1" x:Name="TextRegPass" Width="300" Height="28" HorizontalAlignment="Left" />
                            </Grid>
                            <Grid Height="28" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="邀请码" VerticalAlignment="Center" Margin="1,0,16,0" />
                                <local:MyTextBox Grid.Column="1" x:Name="TextRegInvite" Width="300" Height="28"
                                                 HorizontalAlignment="Left" HintText="向好友索取，形如 RMCL-XXXX-XXXX" />
                            </Grid>
                            <Grid Height="35">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <local:MyButton x:Name="BtnRegister" Text="注册并登录" MinWidth="130" Height="35" Padding="13,0" ColorType="Highlight" Margin="0,0,12,0" />
                                <local:MyButton Grid.Column="1" x:Name="BtnOpenLogin" Text="已有账号，去登录" MinWidth="150" Height="35" Padding="13,0" />
                            </Grid>
                        </StackPanel>

                        <!-- RaySkin -->
                        <StackPanel x:Name="PanRayskin" Visibility="Collapsed">
                            <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,14"
                                       Text="将使用启动页最近一次登录的 RaySkin 账号完成验证，并把该账号的邮箱绑定到好友账号。首次使用会自动创建好友账号，不需要邀请码。" />
                            <Border Background="{DynamicResource ColorBrushGlassInner}" CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
                                <TextBlock x:Name="LabRayskinAccount" TextWrapping="Wrap" LineHeight="19" Text="正在读取 RaySkin 账号……" />
                            </Border>
                            <Grid Height="35">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <local:MyButton x:Name="BtnRayskinLogin" Text="一键登录" MinWidth="120" Height="35" Padding="13,0" ColorType="Highlight" />
                                <local:MyButton Grid.Column="1" x:Name="BtnRayskinRefresh" Text="重新读取账号" MinWidth="120" Height="35" Padding="13,0" HorizontalAlignment="Left" Margin="12,0,0,0" />
                            </Grid>
                        </StackPanel>

                        <TextBlock x:Name="LabAuthStatus" Margin="1,14,0,0" FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorBrush3}" Text="" />
                    </StackPanel>
                </local:MyCard>
            </StackPanel>

            <!-- ===== 已登录 ===== -->
            <StackPanel x:Name="PanSelf" Visibility="Collapsed">
                <local:MyCard Margin="0,15" Title="我的账号">
                    <StackPanel Margin="25,40,25,18">
                        <Grid Height="28" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="昵称" VerticalAlignment="Center" Margin="1,0,16,0" />
                            <TextBlock Grid.Column="1" x:Name="LabSelfName" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </Grid>
                        <Grid Height="28" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="邮箱" VerticalAlignment="Center" Margin="1,0,16,0" />
                            <TextBlock Grid.Column="1" x:Name="LabSelfEmail" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Height="28" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="我的邀请码" VerticalAlignment="Center" Margin="1,0,16,0" />
                            <local:MyTextBox Grid.Column="1" x:Name="TextMyInvite" Width="220" Height="28" IsReadOnly="True" HorizontalAlignment="Left" />
                            <local:MyButton Grid.Column="2" x:Name="BtnCopyInvite" Text="复制" MinWidth="72" Height="28" Padding="13,0" Margin="12,0,0,0" />
                            <local:MyButton Grid.Column="3" x:Name="BtnRefreshInvite" Text="刷新用量" MinWidth="88" Height="28" Padding="10,0" Margin="10,0,0,0" />
                            <TextBlock Grid.Column="4" x:Name="LabInviteUse" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.62" />
                        </Grid>
                        <Grid Height="35">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <local:MyButton x:Name="BtnLogout" Text="退出登录" MinWidth="120" Height="35" Padding="13,0" />
                        </Grid>
                    </StackPanel>
                </local:MyCard>

                <local:MyCard Margin="0,0,0,15" Title="聊天记录">
                    <StackPanel Margin="25,40,25,18">
                        <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,14"
                                   Text="把服务器上已有的历史一次性回填到本机缓存（不受「漫游」开关限制），恢复后离线也能查看。只想恢复某个会话，用下面的「聊天记录漫游」卡片。" />
                        <Grid Height="35">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <local:MyButton x:Name="BtnRestore" Text="恢复本地聊天记录" MinWidth="160" Height="35" Padding="13,0" ColorType="Highlight" Margin="0,0,12,0" />
                            <local:MyButton Grid.Column="1" x:Name="BtnRestoreAll" Text="从头恢复全部" MinWidth="130" Height="35" Padding="13,0" />
                        </Grid>
                        <TextBlock x:Name="LabRestoreStatus" Margin="1,12,0,0" FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorBrush3}" Text="" />

                        <Rectangle Height="1" Margin="0,16,0,14" Fill="{DynamicResource ColorBrushGray4}" Opacity="0.25" />
                        <TextBlock x:Name="LabLocalPath" TextWrapping="Wrap" FontSize="12" Opacity="0.62"
                                   LineHeight="18" Text="本机缓存位置：正在读取……" />
                        <Grid Height="35" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <local:MyButton x:Name="BtnClearLocal" Text="清除本地聊天记录" MinWidth="150" Height="35" Padding="13,0" Margin="0,0,12,0" />
                            <local:MyButton Grid.Column="1" x:Name="BtnOpenLocal" Text="打开缓存文件夹" MinWidth="130" Height="35" Padding="13,0" />
                            <TextBlock Grid.Column="2" x:Name="LabLocalSize" VerticalAlignment="Center" Margin="14,0,0,0"
                                       FontSize="12" Opacity="0.6" Text="" />
                        </Grid>
                        <TextBlock Margin="1,12,0,0" FontSize="12" Opacity="0.55" TextWrapping="Wrap" LineHeight="18"
                                   Text="只删除本机缓存，服务器上的历史记录不受影响，重新打开会话会再次同步。设置里的「清理游戏垃圾」不会动这里。" />
                    </StackPanel>
                </local:MyCard>

                <local:MyCard Margin="0,0,0,15" Title="聊天记录漫游">
                    <StackPanel Margin="25,40,25,18">
                        <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,12"
                                   Text="默认不保存到云端。只有在这里开启漫游的会话，聊天记录才会长期保存在服务器上；换电脑或重装后可以单独把某个会话的记录恢复到本机。" />
                        <StackPanel x:Name="PanRoam" />
                        <TextBlock x:Name="LabRoamHint" Margin="1,10,0,0" FontSize="12" Opacity="0.62" TextWrapping="Wrap" Text="" />
                    </StackPanel>
                </local:MyCard>
            </StackPanel>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
