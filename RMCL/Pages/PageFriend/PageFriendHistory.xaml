<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:RMCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageFriendHistory" PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="25,10">
            <local:MyCard Margin="0,15" Title="历史记录">
                <StackPanel Margin="25,40,25,18">
                    <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,12"
                               Text="按关键词检索保存在服务端的全部聊天记录，包括已经不在会话列表里的好友与群聊。点击任意一条即可跳到对应会话。" />
                    <Grid Height="30" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MyTextBox x:Name="TextKeyword" Height="30" HintText="输入关键词，留空则按时间列出最近的记录" />
                        <local:MyComboBox Grid.Column="1" x:Name="ComboScope" Width="110" Height="30" Margin="10,0,0,0">
                            <local:MyComboBoxItem Content="全部会话" IsSelected="True" Tag="0" />
                            <local:MyComboBoxItem Content="仅好友" Tag="1" />
                            <local:MyComboBoxItem Content="仅群聊" Tag="2" />
                        </local:MyComboBox>
                        <local:MyButton Grid.Column="2" x:Name="BtnSearch" Text="查询" MinWidth="90" Height="30"
                                        Padding="13,0" Margin="10,0,0,0" ColorType="Highlight" />
                    </Grid>
                    <Grid Height="26" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LabHint" VerticalAlignment="Center" FontSize="12" Opacity="0.6" Text="输入关键词后点查询。" />
                        <local:MyButton Grid.Column="1" x:Name="BtnLoadMore" Text="加载更多" MinWidth="90" Height="26"
                                        Padding="10,0" Visibility="Collapsed" />
                    </Grid>
                    <StackPanel x:Name="PanResult" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
