<Grid x:Class="PageLoginAuth" Tag="False"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RMCL"
      mc:Ignorable="d" d:DesignWidth="317.6" Margin="0,0,0,-2">
    <Grid.Resources>
        <!-- 与邮箱下拉框的条目保持一致：同样的小列表项 + 右侧删除按钮 -->
        <DataTemplate x:Key="AuthServerItemTemplate">
            <local:MyListItem Title="{Binding Display}" FontSize="13" MaxHeight="26" IsScaleAnimationEnabled="False" Margin="-3,0,0,0">
                <local:MyListItem.Buttons>
                    <x:Array Type="local:MyIconButton">
                        <local:MyIconButton Grid.Column="1" Height="20" Width="20" VerticalAlignment="Center" Tag="{Binding Server}" Click="BtnServerDelete_Click"
                                            ToolTip="删除这个认证服务器"
                                            Logo="F1 M 26.9166,22.1667L 37.9999,33.25L 49.0832,22.1668L 53.8332,26.9168L 42.7499,38L 53.8332,49.0834L 49.0833,53.8334L 37.9999,42.75L 26.9166,53.8334L 22.1666,49.0833L 33.25,38L 22.1667,26.9167L 26.9166,22.1667 Z" />
                    </x:Array>
                </local:MyListItem.Buttons>
            </local:MyListItem>
        </DataTemplate>
        <Style x:Key="AuthServerComboBoxItem" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="ContentTemplate" Value="{StaticResource AuthServerItemTemplate}" />
        </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="10" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="10" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="224" />
    </Grid.ColumnDefinitions>
    <TextBlock Text="服务器" Grid.Row="0" VerticalAlignment="Center" />
    <local:MyComboBox Grid.Row="0" Grid.Column="1" Height="28" x:Name="ComboServer"
                      ItemContainerStyle="{StaticResource AuthServerComboBoxItem}"
                      ToolTip="切换第三方认证服务器；账号与密码按服务器分别保存，点条目右侧的 × 可删除服务器" />
    <TextBlock Text="邮箱" Grid.Row="2" VerticalAlignment="Center" />
    <local:MyComboBox Grid.Row="2" Grid.Column="1" IsEditable="True" Height="28" x:Name="ComboName" />
    <TextBlock Text="密码" Grid.Row="4" VerticalAlignment="Center" />
    <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="TextPass" />
    <local:MyCheckBox x:Name="CheckRemember" Tag="LoginRemember" Height="20" Margin="-1,12,80,0" Text="记住密码" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" />
    <local:MyTextButton Margin="0,12,2,0" x:Name="BtnLink" Content="注册账号" Grid.Row="5" HorizontalAlignment="Right" Grid.Column="1" Padding="20,0,0,0" HorizontalContentAlignment="Right" FontSize="13" VerticalContentAlignment="Center" />
</Grid>
