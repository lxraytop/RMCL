<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:RMCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d" x:Class="PageSetupFeature"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="创建快捷方式">
                <StackPanel Margin="25,40,25,18">
                    <TextBlock x:Name="LabShortcutInfo" Margin="1,0,0,12" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrush3}" Text="正在检查快捷方式……" />
                    <Grid Height="35" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnShortcutDesktop" Text="创建桌面快捷方式" MinWidth="140" Height="35" Padding="13,0" ColorType="Highlight" Margin="0,0,20,0" />
                        <local:MyButton x:Name="BtnShortcutStartMenu" Text="添加到开始菜单" MinWidth="140" Height="35" Padding="13,0" Grid.Column="1" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,15" Title="内存优化">
                <StackPanel Margin="25,40,25,18">
                    <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,12"
                               Text="内存优化会申请管理员权限，让系统中所有进程归还当前暂未使用的物理内存，通常能把物理内存占用降低约三分之一，并且不局限于 Minecraft。&#xa;如果使用机械硬盘，优化后的一小段时间内可能会出现明显的卡顿。" />
                    <Border Background="{DynamicResource ColorBrushGlassInner}" CornerRadius="12" Padding="14,10" Margin="0,0,0,12">
                        <TextBlock x:Name="LabMemoryInfo" TextWrapping="Wrap" LineHeight="19" Text="正在读取内存信息……" />
                    </Border>
                    <local:MyCheckBox local:SettingService.Key="LaunchArgumentRam" Text="启动游戏前进行内存优化" Margin="-1,0,0,4" Height="22" />
                    <TextBlock Text="与「设置 → 启动」中的同名选项是同一个开关；开启后每次启动游戏都会请求管理员权限。" Opacity="0.62" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Grid Height="35" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnMemoryOptimize" Text="立即优化内存" MinWidth="140" Height="35" Padding="13,0" ColorType="Highlight" Margin="0,0,20,0" />
                        <local:MyButton x:Name="BtnMemoryRefresh" Text="刷新信息" MinWidth="140" Height="35" Padding="13,0" Grid.Column="1" />
                    </Grid>
                    <TextBlock x:Name="LabMemoryStatus" Margin="1,12,0,0" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrush3}" Text="尚未执行内存优化。" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="清理游戏垃圾">
                <StackPanel Margin="25,40,25,18">
                    <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,12"
                               Text="清理安装与下载过程中产生的临时文件、下载缓存与启动器日志。清理不会影响已经安装的 Minecraft 版本、Mod 与存档。" />
                    <Border Background="{DynamicResource ColorBrushGlassInner}" CornerRadius="12" Padding="14,10" Margin="0,0,0,12">
                        <TextBlock x:Name="LabJunkInfo" TextWrapping="Wrap" LineHeight="19" Text="正在统计垃圾文件……" />
                    </Border>
                    <Grid Height="35" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnJunkClean" Text="清理垃圾" MinWidth="140" Height="35" Padding="13,0" ColorType="Highlight" Margin="0,0,20,0" />
                        <local:MyButton x:Name="BtnJunkRefresh" Text="重新统计" MinWidth="140" Height="35" Padding="13,0" Grid.Column="1" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="下载自定义文件">
                <StackPanel Margin="25,40,25,18">
                    <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,12"
                               Text="填入一个直链地址，把文件下载到指定目录。适合下载没有收录进下载页的资源；需要登录、带防盗链或必须先进网页才能拿到地址的文件不适用。" />
                    <Grid Height="28" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="文件地址" Margin="1,0,16,0" />
                        <local:MyTextBox Grid.Column="1" x:Name="TextCustomUrl" Width="420" Height="28"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         HintText="https://example.com/file.zip" />
                    </Grid>
                    <Grid Height="28" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="保存到" Margin="1,0,16,0" />
                        <local:MyTextBox Grid.Column="1" x:Name="TextCustomFolder" Width="420" Height="28"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         HintText="选择一个文件夹" />
                        <local:MyButton Grid.Column="2" x:Name="BtnCustomFolder" Text="选择文件夹" MinWidth="110" Height="28"
                                        Padding="13,0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                    <Grid Height="28" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="文件名" Margin="1,0,16,0" />
                        <local:MyTextBox Grid.Column="1" x:Name="TextCustomName" Width="420" Height="28"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         HintText="留空则按地址自动命名" />
                    </Grid>
                    <Grid Height="35" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnCustomDownload" Text="开始下载" MinWidth="140" Height="35" Padding="13,0" ColorType="Highlight" Margin="0,0,20,0" />
                        <local:MyButton x:Name="BtnCustomCancel" Text="取消下载" MinWidth="140" Height="35" Padding="13,0" Grid.Column="1" Visibility="Collapsed" />
                    </Grid>
                    <StackPanel x:Name="PanCustomProgress" Visibility="Collapsed" Margin="0,12,0,0">
                        <Grid Height="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ColCustomFill" Width="0*" />
                                <ColumnDefinition x:Name="ColCustomRest" Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource ColorBrush2}" CornerRadius="3" />
                            <Border Grid.Column="1" Background="{DynamicResource ColorBrushGlassInner}" CornerRadius="3" />
                        </Grid>
                        <TextBlock x:Name="LabCustomProgress" FontSize="12" Opacity="0.75" Margin="1,6,0,0" Text="正在下载……" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
