<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:RMCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d" x:Class="PageSetupFeature"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="内存优化">
                <StackPanel Margin="25,40,25,18">
                    <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,12"
                               Text="内存优化会申请管理员权限，让系统中所有进程归还当前暂未使用的物理内存，通常能把物理内存占用降低约三分之一，并且不局限于 Minecraft。&#xa;如果使用机械硬盘，优化后的一小段时间内可能会出现明显的卡顿。" />
                    <Border Background="{DynamicResource ColorBrushGlassInner}" CornerRadius="12" Padding="14,10" Margin="0,0,0,12">
                        <TextBlock x:Name="LabMemoryInfo" TextWrapping="Wrap" LineHeight="19" Text="正在读取内存信息……" />
                    </Border>
                    <local:MyCheckBox local:SettingService.Key="LaunchArgumentRam" Text="启动游戏前进行内存优化" Margin="-1,0,0,4" Height="22" />
                    <TextBlock Text="与「设置 → 启动」中的同名选项是同一个开关；开启后每次启动游戏都会请求管理员权限。" Opacity="0.62" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Grid Height="35" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnMemoryOptimize" Text="立即优化内存" MinWidth="140" Height="35" Padding="13,0" ColorType="Highlight" Margin="0,0,20,0" />
                        <local:MyButton x:Name="BtnMemoryRefresh" Text="刷新信息" MinWidth="140" Height="35" Padding="13,0" Grid.Column="1" />
                    </Grid>
                    <TextBlock x:Name="LabMemoryStatus" Margin="1,12,0,0" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrush3}" Text="尚未执行内存优化。" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="清理游戏垃圾">
                <StackPanel Margin="25,40,25,18">
                    <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,12"
                               Text="清理安装与下载过程中产生的临时文件、下载缓存与启动器日志。清理不会影响已经安装的 Minecraft 版本、Mod 与存档。" />
                    <Border Background="{DynamicResource ColorBrushGlassInner}" CornerRadius="12" Padding="14,10" Margin="0,0,0,12">
                        <TextBlock x:Name="LabJunkInfo" TextWrapping="Wrap" LineHeight="19" Text="正在统计垃圾文件……" />
                    </Border>
                    <Grid Height="35" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnJunkClean" Text="清理垃圾" MinWidth="140" Height="35" Padding="13,0" ColorType="Highlight" Margin="0,0,20,0" />
                        <local:MyButton x:Name="BtnJunkRefresh" Text="重新统计" MinWidth="140" Height="35" Padding="13,0" Grid.Column="1" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="软件更新">
                <StackPanel Margin="25,40,25,18">
                    <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,12"
                               Text="从 GitHub 的 Release 页面检查启动器的新版本。发布产物是单个 exe，下载完成后退出启动器即可完成替换。" />
                    <Border Background="{DynamicResource ColorBrushGlassInner}" CornerRadius="12" Padding="14,10" Margin="0,0,0,12">
                        <TextBlock x:Name="LabUpdateInfo" TextWrapping="Wrap" LineHeight="19" Text="正在读取版本信息……" />
                    </Border>
                    <local:MyCheckBox local:SettingService.Key="ToolLauncherUpdateAuto" Text="自动更新" Margin="-1,0,0,4" Height="22" />
                    <TextBlock Text="开启后每次启动都会检查更新；发现新版本时弹窗展示更新公告，确认后才开始下载，并在退出启动器时完成安装（不会自动重启启动器）。" Opacity="0.62" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Grid Height="35" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnUpdateCheck" Text="检查更新" MinWidth="140" Height="35" Padding="13,0" ColorType="Highlight" Margin="0,0,20,0" />
                        <local:MyButton x:Name="BtnUpdateInstall" Text="下载并安装" MinWidth="140" Height="35" Padding="13,0" Grid.Column="1" Margin="0,0,20,0" Visibility="Collapsed" />
                        <local:MyButton x:Name="BtnUpdatePage" Text="打开发布页" MinWidth="140" Height="35" Padding="13,0" Grid.Column="2" />
                    </Grid>
                    <TextBlock x:Name="LabUpdateNotesTitle" Text="更新公告" Margin="1,14,0,6" FontSize="12.5" Opacity="0.7" Visibility="Collapsed" />
                    <Border x:Name="PanUpdateNotes" Visibility="Collapsed" Background="{DynamicResource ColorBrushGlassInner}" CornerRadius="12" Padding="14,10">
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="TextUpdateNotes" TextWrapping="Wrap" LineHeight="19" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
