<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:RMCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageInstanceSaves"
    PanScroll="PanBack">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <local:MyCard x:Name="PanNoWorld" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" Visibility="Collapsed">
                <Grid Margin="20,17">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="0,0,0,9" HorizontalAlignment="Center"
                               Text="这个版本还没有存档" FontSize="19"
                               UseLayoutRounding="True" SnapsToDevicePixels="True"
                               Foreground="{DynamicResource ColorBrush3}" />
                    <Rectangle Grid.Row="1" HorizontalAlignment="Stretch" Height="2" Fill="{DynamicResource ColorBrush3}" />
                    <TextBlock Grid.Row="2" Margin="10,15,10,5" TextWrapping="Wrap" HorizontalAlignment="Center"
                               Text="进入游戏创建一个世界，存档就会出现在这里，可以随时备份和还原。" />
                    <WrapPanel Grid.Row="3" Margin="10,20,10,5" HorizontalAlignment="Center" Orientation="Horizontal">
                        <local:MyButton Height="35" MinWidth="140" Text="打开文件夹" Margin="5,0" Padding="13,0"
                                        ColorType="Highlight" Click="BtnManageOpen_Click" />
                        <local:MyButton Height="35" MinWidth="140" Text="粘贴存档" Margin="5,0" Padding="13,0"
                                        Click="BtnPaste_Click" />
                    </WrapPanel>
                </Grid>
            </local:MyCard>

            <StackPanel x:Name="PanContent" Orientation="Vertical" Margin="25,10,25,10" Visibility="Collapsed">
                <local:MySearchBox Margin="0,15" HintText="搜索存档：名称" x:Name="SearchBox" TextChanged="SearchBox_TextChanged" />

                <local:MyCard Margin="0,0,0,15" Title="快捷操作">
                    <Grid Height="35" Margin="25,40,15,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton Grid.Column="0" MinWidth="140" Text="打开文件夹" Padding="13,0" Margin="0,0,20,0"
                                        HorizontalAlignment="Left" ColorType="Highlight" Click="BtnManageOpen_Click" />
                        <local:MyButton Grid.Column="1" MinWidth="140" Text="粘贴存档" Padding="13,0" Margin="0,0,20,0"
                                        HorizontalAlignment="Left" Click="BtnPaste_Click" />
                    </Grid>
                </local:MyCard>

                <local:MyCard Margin="0,0,0,15" x:Name="PanListBack" VerticalAlignment="Top" Title="存档" MinHeight="55">
                    <Grid>
                        <StackPanel Margin="0,13,15,0" Orientation="Horizontal" VerticalAlignment="Top"
                                    HorizontalAlignment="Right" Height="28">
                            <local:MyIconTextButton x:Name="BtnSort" Text="排序：上次游玩" Click="BtnSort_Click" />
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="PanList" Margin="20,48,18,22" VerticalAlignment="Top" />
                </local:MyCard>
            </StackPanel>
        </Grid>
    </local:MyScrollViewer>
</local:MyPageRight>
