<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:RMCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageInstanceCompResource"
    PanScroll="PanBack">
    <Grid>
        <Grid x:Name="PanAllBack">
            <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PanMain" Margin="25,10,25,10">
                    <local:MySearchBox Margin="0,15" HintText="搜索资源：名称 / 描述" x:Name="SearchBox" TextChanged="SearchBox_TextChanged" />

                    <local:MyCard Margin="0,0,0,15" x:Name="PanManage">
                        <WrapPanel Margin="15,8,0,15">
                            <local:MyButton x:Name="BtnManageOpen" MinWidth="110" Text="打开文件夹" Padding="13,7" Margin="0,7,15,0"
                                            HorizontalAlignment="Left" ColorType="Highlight" Click="BtnManageOpen_Click" />
                            <local:MyButton x:Name="BtnManageInstall" MinWidth="110" Text="从文件安装" Padding="13,7" Margin="0,7,15,0"
                                            HorizontalAlignment="Left" Click="BtnManageInstall_Click" />
                            <local:MyButton x:Name="BtnManageDownload" MinWidth="110" Text="下载新资源" Padding="13,7" Margin="0,7,15,0"
                                            HorizontalAlignment="Left" Click="BtnManageDownload_Click" />
                            <local:MyButton x:Name="BtnManageSelectAll" MinWidth="110" Text="全选" Padding="13,7" Margin="0,7,15,0"
                                            HorizontalAlignment="Left" Click="BtnManageSelectAll_Click" />
                            <local:MyButton x:Name="BtnManageExport" MinWidth="110" Text="导出信息" Padding="13,7" Margin="0,7,15,0"
                                            HorizontalAlignment="Left" Click="BtnManageExport_Click" />
                        </WrapPanel>
                    </local:MyCard>

                    <local:MyCard x:Name="PanListBack" VerticalAlignment="Top" Margin="0,0,0,14" Title=" " MinHeight="55">
                        <StackPanel x:Name="PanFilter" Margin="15,13,0,0" Orientation="Horizontal" VerticalAlignment="Top"
                                    HorizontalAlignment="Left" Height="28">
                            <local:MyRadioButton x:Name="BtnFilterAll" Tag="0" ColorType="Highlight" Text="全部" Check="ChangeFilter"
                                                 VerticalAlignment="Center" Margin="2,0" />
                            <local:MyRadioButton x:Name="BtnFilterEnabled" Tag="1" ColorType="Highlight" Text="已启用" Check="ChangeFilter"
                                                 VerticalAlignment="Center" Margin="2,0" />
                            <local:MyRadioButton x:Name="BtnFilterDisabled" Tag="2" ColorType="Highlight" Text="已禁用" Check="ChangeFilter"
                                                 VerticalAlignment="Center" Margin="2,0" />
                        </StackPanel>
                        <StackPanel Margin="0,13,15,0" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Height="28">
                            <local:MyIconTextButton x:Name="BtnSort" Text="排序：资源名" Click="BtnSort_Click" />
                        </StackPanel>
                        <StackPanel x:Name="PanList" Margin="20,48,18,22" VerticalAlignment="Top" />
                    </local:MyCard>
                </StackPanel>
            </local:MyScrollViewer>
        </Grid>

        <!-- 空状态卡片必须与 PanAllBack 平级：没有资源时 PanAllBack 会被折叠，
             若把它放在 PanAllBack 内部，折叠祖先会连它一起藏掉，页面就变成一片空白 -->
        <local:MyCard x:Name="PanEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" Visibility="Collapsed">
            <Grid Margin="20,17">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="TxtEmptyTitle" Grid.Row="0" Margin="0,0,0,9" HorizontalAlignment="Center"
                           FontSize="19" UseLayoutRounding="True" SnapsToDevicePixels="True"
                           Foreground="{DynamicResource ColorBrush3}" Text="这里还没有资源" />
                <Rectangle Grid.Row="1" HorizontalAlignment="Stretch" Height="2" Fill="{DynamicResource ColorBrush3}" />
                <TextBlock x:Name="TxtEmptyDescription" Grid.Row="2" Margin="10,15,10,5" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Text="从文件安装，或者去下载页找找。" />
                <WrapPanel Grid.Row="3" Margin="10,20,10,5" HorizontalAlignment="Center" Orientation="Horizontal">
                    <local:MyButton Height="35" MinWidth="140" Text="从文件安装" Margin="5,0" Padding="13,0"
                                    ColorType="Highlight" Click="BtnManageInstall_Click" />
                    <local:MyButton Height="35" MinWidth="140" Text="下载新资源" Margin="5,0" Padding="13,0"
                                    Click="BtnManageDownload_Click" />
                    <local:MyButton Height="35" MinWidth="140" Text="打开文件夹" Margin="5,0" Padding="13,0"
                                    Click="BtnManageOpen_Click" />
                </WrapPanel>
            </Grid>
        </local:MyCard>

        <local:MyCard x:Name="PanLoad" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0" UseAnimation="False">
            <local:MyLoading Text="正在读取资源……" Margin="20,20,20,17" HorizontalAlignment="Center" x:Name="Load" />
        </local:MyCard>

        <local:MyCard x:Name="CardSelect" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                      Margin="25,25,25,0" UseAnimation="False">
            <TextBlock x:Name="LabSelect" Text="已选择 0 项" HorizontalAlignment="Center" VerticalAlignment="Top"
                       Margin="9" Foreground="{DynamicResource ColorBrush2}" />
            <StackPanel Orientation="Horizontal" Margin="5,28,5,5">
                <local:MyIconTextButton x:Name="BtnSelectEnable" Text="启用" Margin="4,0" Click="BtnSelectEnable_Click" />
                <local:MyIconTextButton x:Name="BtnSelectDisable" Text="禁用" Margin="4,0" Click="BtnSelectDisable_Click" />
                <local:MyIconTextButton x:Name="BtnSelectDelete" Text="删除" Margin="4,0" Click="BtnSelectDelete_Click" />
                <local:MyIconTextButton x:Name="BtnSelectCancel" Text="取消选择" Margin="4,0" Click="BtnSelectCancel_Click" />
            </StackPanel>
        </local:MyCard>
    </Grid>
</local:MyPageRight>
