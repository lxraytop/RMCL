<local:MyPageRight
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RMCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             mc:Ignorable="d" x:Class="PageLinkMain"
             d:DesignWidth="800" d:DesignHeight="800">
    <Grid>
        <Grid x:Name="PanLoad">
            <local:MyCard HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="CardLoad" MinWidth="300">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="25" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="20" />
                    </Grid.RowDefinitions>
                    <local:MyLoading Grid.Column="1" Grid.Row="1" x:Name="Load" Grid.RowSpan="3" Margin="0,-4,0,-29" HorizontalAlignment="Center"
                                     Text="" TextError="" TextErrorInherit="False" AutoRun="False" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                        <local:MyLoading.RenderTransform>
                            <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                        </local:MyLoading.RenderTransform>
                    </local:MyLoading>
                    <TextBlock x:Name="LabLoadTitle" Grid.Column="3" Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Center" Text="正在创建联机房间" FontSize="19"
                               Margin="0,0,25,1" Foreground="{Binding Foreground, ElementName=Load}" IsHitTestVisible="False" />
                    <TextBlock x:Name="LabLoadDesc" Grid.Column="3" Grid.ColumnSpan="3" Grid.Row="2" VerticalAlignment="Center" Margin="0,5,10,-5" Text="下载联机模块中……" FontSize="14" 
                               LineHeight="19" MaxWidth="450" MaxHeight="220" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrushGray3}" IsHitTestVisible="False" />
                    <local:MyIconButton Grid.Column="5" Grid.Row="1" x:Name="BtnLoadCancel" Height="25" Width="25" 
                                        VerticalAlignment="Top" Margin="0,-13,-13,0"
                                        Theme="Black" Opacity="0.3"
                                        ToolTip="取消" ToolTipService.InitialShowDelay="100"
                                        LogoScale="0.72" Logo="F1 M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 2,0Z" />
                    <Grid Height="12" VerticalAlignment="Bottom" Grid.ColumnSpan="100" Grid.RowSpan="100" Margin="0,0,0,-0.6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0*" x:Name="ColumnProgressA" />
                            <ColumnDefinition Width="1*" x:Name="ColumnProgressB" />
                        </Grid.ColumnDefinitions>
                        <Grid.Clip>
                            <RectangleGeometry RadiusX="6" RadiusY="6" x:Name="RectProgressClip" />
                        </Grid.Clip>
                        <Rectangle Fill="{Binding Foreground, ElementName=Load}" VerticalAlignment="Bottom" Height="2" />
                    </Grid>
                </Grid>
            </local:MyCard>
        </Grid>
        <Grid x:Name="PanContent">
            <local:MyScrollViewer x:Name="PanSelect" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="25,10,25,40" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- 顶部状态胶囊：节点连通性 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                        <local:MyCard x:Name="CardNodeState" CornerRadius="13">
                            <StackPanel Orientation="Horizontal" Background="{DynamicResource ColorBrushSemiTransparent}"
                                        MouseLeftButtonUp="CardNodeState_MouseLeftButtonUp"
                                        ToolTip="点击重新测试联机节点的连通性">
                                <Path IsHitTestVisible="False" Height="13" Width="13" Stretch="Uniform"
                                      Fill="{DynamicResource ColorBrushGray1}" Margin="12,7,7,7"
                                      Data="M512 817c-48.6 0-88-39.4-88-88s39.4-88 88-88 88 39.4 88 88-39.4 88-88 88zM237.7 565.7C308.3 474.6 397.4 429 504.8 429c118.4 0 214.2 55.4 287.4 166.3l-53.4 30.4c-13.8 7.9-31.4 4.4-41.1-8.2-50.3-64.9-114.6-97.4-192.9-97.4-86.9 0-156.8 40.3-210 121l-48-28c-15.3-8.9-20.4-28.5-11.5-43.8a32 32 0 0 1 2.3-3.5z" />
                                <TextBlock x:Name="LabNodeState" IsHitTestVisible="False" Text="节点测试"
                                           VerticalAlignment="Center" Foreground="{DynamicResource ColorBrushGray1}"
                                           FontSize="13" Margin="0,0,12,0" />
                            </StackPanel>
                        </local:MyCard>
                    </StackPanel>

                    <!-- 加入房间 -->
                    <local:MyCard x:Name="CardJoin" Title="加入房间" Margin="0,0,0,12" MinWidth="470">
                        <StackPanel Margin="25,38,25,18">
                            <TextBlock Text="把朋友发来的邀请码粘贴到下面，就可以直接进入对方的房间。"
                                       TextWrapping="Wrap" FontSize="13" LineHeight="18"
                                       Foreground="{DynamicResource ColorBrushGray3}" />
                            <DockPanel Margin="0,12,0,0" Height="28">
                                <local:MyButton x:Name="BtnJoin" DockPanel.Dock="Right" Text="加入" ColorType="Highlight"
                                                Width="64" Height="28" Padding="0" Margin="10,0,0,0" Click="BtnJoin_Click" />
                                <local:MyButton x:Name="BtnJoinPaste" DockPanel.Dock="Right" Text="粘贴"
                                                Width="64" Height="28" Padding="0" Margin="10,0,0,0" Click="BtnJoinPaste_Click" />
                                <local:MyButton x:Name="BtnJoinClear" DockPanel.Dock="Right" Text="清空"
                                                Width="64" Height="28" Padding="0" Margin="10,0,0,0" Click="BtnJoinClear_Click" />
                                <local:MyTextBox x:Name="TextJoinCode" MaxLines="1" AcceptsReturn="False"
                                                 KeyDown="TextJoinCode_KeyDown"
                                                 HintText="邀请码，例如 P04D2-1A2B3-02000" />
                            </DockPanel>
                            <Grid Margin="0,10,0,0" Height="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="游戏版本" Margin="0,0,12,0" FontSize="13"
                                           Foreground="{DynamicResource ColorBrushGray3}" />
                                <local:MyComboBox Grid.Column="1" x:Name="ComboLaunchVersion"
                                                  ToolTip="加入房间后点「启动并进入」，就会用这个版本打开游戏并直接连进房间。"
                                                  HintText="选择要启动的 Minecraft 版本" />
                            </Grid>
                        </StackPanel>
                    </local:MyCard>

                    <!-- 创建房间 -->
                    <local:MyCard x:Name="CardCreate" Title="创建房间" Margin="0,0,0,12" MinWidth="470">
                        <StackPanel Margin="25,38,25,18">
                            <TextBlock Text="在单人游戏里按 Esc → 对局域网开放，然后选中下面自动检测到的世界。"
                                       TextWrapping="Wrap" FontSize="13" LineHeight="18"
                                       Foreground="{DynamicResource ColorBrushGray3}" />
                            <DockPanel Margin="0,12,0,0" Height="28">
                                <local:MyButton x:Name="BtnCreate" DockPanel.Dock="Right" Text="创建" ColorType="Highlight"
                                                Width="82" Height="28" Padding="0" Margin="10,0,0,0" Click="BtnCreate_Click" />
                                <local:MyButton x:Name="BtnScanWorld" DockPanel.Dock="Right" Text="刷新"
                                                Width="82" Height="28" Padding="0" Margin="10,0,0,0" Click="BtnScanWorld_Click" />
                                <local:MyButton x:Name="BtnInputPort" DockPanel.Dock="Right" Text="手动端口"
                                                Width="82" Height="28" Padding="0" Margin="10,0,0,0" Click="BtnInputPort_Click" />
                                <local:MyComboBox x:Name="ComboWorldList" HintText="未检测到局域网世界" />
                            </DockPanel>
                            <TextBlock x:Name="LabWorldHint" Text="" TextWrapping="Wrap" FontSize="12" LineHeight="17"
                                       Margin="0,9,0,0" Foreground="{DynamicResource ColorBrushGray3}" />
                        </StackPanel>
                    </local:MyCard>

                    <!-- 高级设置 -->
                    <local:MyCard x:Name="CardAdvanced" Title="高级设置" IsSwapped="True" CanSwap="True"
                                  MinWidth="470" Margin="0,0,0,12">
                        <StackPanel Margin="25,38,25,18">
                            <TextBlock Text="节点测试" FontSize="13" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,0,0,8" />
                            <StackPanel x:Name="StackNodeList" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <local:MyButton x:Name="BtnTestNode" Text="测试节点" Width="110" Height="28" Padding="0"
                                                HorizontalAlignment="Left" ColorType="Highlight" Click="BtnTestNode_Click" />
                                <TextBlock x:Name="LabNodeSummary" VerticalAlignment="Center" Margin="15,0,0,0"
                                           TextWrapping="Wrap" FontSize="13" LineHeight="18" MaxWidth="290"
                                           Foreground="{DynamicResource ColorBrushGray2}" />
                            </StackPanel>
                            <Rectangle Height="1" Margin="0,16,0,14" Fill="{DynamicResource ColorBrushGray4}" Opacity="0.25" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="28" />
                                </Grid.RowDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="连接模式" Margin="0,0,20,0" />
                                <local:MyComboBox Grid.Column="1" x:Name="ComboLatencyMode" local:SettingService.Key="LinkLatencyMode">
                                    <local:MyComboBoxItem Content="优先直连" IsSelected="True" ToolTip="尽量不进行中转，而是 P2P 直连。" />
                                    <local:MyComboBoxItem Content="优先低延迟" ToolTip="如果使用中转节点能降低延迟，就不进行直连。" />
                                </local:MyComboBox>
                                <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="自定义节点" Margin="0,0,20,0" />
                                <local:MyTextBox Grid.Row="2" Grid.Column="1" x:Name="TextCustomPeer" MaxHeight="28"
                                                 local:SettingService.Key="LinkCustomPeer"
                                                 ToolTip="覆盖 RMCL 自动选择的节点，仅连接此处填写的节点。&#xa;使用逗号分隔多个节点，例如：&#xa;tcp://183.66.27.22:39409&#xa;&#xa;房主和加入者必须连接到至少一个相同节点，才能互相连上。" />
                            </Grid>
                        </StackPanel>
                    </local:MyCard>
                </StackPanel>
            </local:MyScrollViewer>
            <Grid x:Name="PanFinish" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Width="560">
                    <local:MyHint x:Name="HintFinish" Margin="0,0,0,10" Text="你的网络环境差，正使用社区节点进行中继。"
                                  HasBorder="True" HorizontalAlignment="Stretch" Theme="Yellow" />
                    <local:MyCard CornerRadius="13">
                        <StackPanel Margin="25,22,25,20">
                            <StackPanel Orientation="Horizontal">
